{
  "name": "roomle-configurator-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone native configurator example with the browser planning assistant of roomle-ui",
  "workspaces": [
    "minimal-configurator-example",
    "minimla-fence-example"
  ],
  "scripts": {
    "start": "node minimal-configurator-example/start.mjs",
    "dev": "node minimal-configurator-example/start.mjs --dev",
    "start:fence": "node minimla-fence-example/start.mjs",
    "dev:fence": "node minimla-fence-example/start.mjs --dev",
    "test": "npm test --workspaces",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "oxlint": "1.86.0",
    "prettier": "3.8.3"
  }
}
