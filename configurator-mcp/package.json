{
  "name": "configurator-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace of the Roomle configurator MCP server and the chat backend of the configurator example",
  "workspaces": [
    "configurator-mcp-server",
    "configurator-mcp-chat"
  ],
  "scripts": {
    "start": "npm start --workspace configurator-mcp-server",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project configurator-mcp-server/tsconfig.json && tsc --noEmit --project configurator-mcp-chat/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
